    -- WindUI Config Manager stores configs under WindUI/Delex/config/.
    local ConfigManager = self.ConfigManager
    local configNameInput = ""
    local selectedConfig  = nil
    local configDropdown  = nil
    local autoLoadToggle  = nil

    local function trimConfigName(value)
        local name = tostring(value or ""):match("^%s*(.-)%s*$")
        if name == "" or name:find("%.%.") or name:find("[\\/:*?\"<>|%c]") then
            return nil
        end
        return name
    end

    local function getConfigList()
        if not ConfigManager or not ConfigManager.AllConfigs then
            return {}
        end
        local ok, list = pcall(function() return ConfigManager:AllConfigs() end)
        return ok and list or {}
    end

    local function configExists(name)
        for _, existing in ipairs(getConfigList()) do
            if existing == name then return true end
        end
        return false
    end

    local function openConfig(name)
        if not ConfigManager then return nil end
        local create = ConfigManager.Config or ConfigManager.CreateConfig
        if not create then return nil end
        local ok, config = pcall(function() return create(ConfigManager, name) end)
        return ok and config or nil
    end

    local function getConfigModule(name)
        if not name or name == "" then return nil end
        if ConfigManager.GetConfig then
            local ok, config = pcall(function() return ConfigManager:GetConfig(name) end)
            if ok and type(config) == "table" and config.Path then
                return config
            end
        end
        return openConfig(name)
    end

    local function syncAutoLoadToggle()
        if not autoLoadToggle then return end
        local config = getConfigModule(selectedConfig)
        autoLoadToggle:Set(config and config.AutoLoad == true or false, false)
    end

    local function saveAutoLoadState(config, state)
        if not config then return false end
        if config.SetAsCurrent then config:SetAsCurrent() end
        -- Load first so changing only AutoLoad does not overwrite the config's saved values.
        if config.Load then pcall(function() config:Load() end) end
        if config.SetAutoLoad then
            config:SetAutoLoad(state)
        else
            config.AutoLoad = state
        end
        return pcall(function() config:Save() end)
    end

    local function loadAutoLoadConfig()
        if not ConfigManager then return end
        local autoConfigName = nil
        for _, name in ipairs(getConfigList()) do
            local config = getConfigModule(name)
            if config and config.AutoLoad then
                autoConfigName = name
            end
        end
        if autoConfigName then
            selectedConfig = autoConfigName
            if configDropdown and configDropdown.Select then
                pcall(function() configDropdown:Select(autoConfigName) end)
            end
            syncAutoLoadToggle()
        end
    end

    local function refreshConfigDropdown(preferred)
        if not configDropdown then return end
        configDropdown:Refresh(getConfigList(), true)
        selectedConfig = preferred
        if preferred and configDropdown.Select then
            pcall(function() configDropdown:Select(preferred) end)
        end
    end

    -- Section: Config
    local SectionCfg = TabSettings:Section({
        Title = "Config",
        Desc  = "WindUI Config Manager",
        Icon  = "settings",
        Side  = "right",
    })

    if not ConfigManager then
        SectionCfg:Paragraph({
            Title = "Config Manager unavailable",
            Desc  = "This WindUI build does not expose ConfigManager.",
            Icon  = "alert-triangle",
        })
    else
        SectionCfg:Input({
            Title       = "Config Name",
            Placeholder = "Enter Config Name",
            Callback    = function(text) configNameInput = text end,
        })

        local initList = getConfigList()
        selectedConfig = initList[1]
        configDropdown = SectionCfg:Dropdown({
            Title    = "Select Config",
            Values   = initList,
            Value    = selectedConfig,
            AllowNone = true,
            Callback = function(value)
                selectedConfig = value
                syncAutoLoadToggle()
            end,
        })

        autoLoadToggle = SectionCfg:Toggle({
            Title       = "Auto Load Config",
            Description = "Load the selected config when the UI starts",
            Icon        = "refresh-cw",
            Value       = false,
            Callback    = function(state)
                if not selectedConfig or selectedConfig == "" then
                    autoLoadToggle:Set(false, false)
                    WindUI:Notify({ Title = "Config", Content = "Please select a config first", Duration = 3, Icon = "alert-circle" })
                    return
                end

                local config = getConfigModule(selectedConfig)
                if not config then
                    autoLoadToggle:Set(not state, false)
                    WindUI:Notify({ Title = "Config", Content = "Failed to open config", Duration = 3, Icon = "alert-circle" })
                    return
                end

                if state then
                    for _, name in ipairs(getConfigList()) do
                        if name ~= selectedConfig then
                            local other = getConfigModule(name)
                            if other and other.AutoLoad then
                                saveAutoLoadState(other, false)
                            end
                        end
                    end
                end

                local ok = saveAutoLoadState(config, state)
                if not ok then
                    autoLoadToggle:Set(not state, false)
                    WindUI:Notify({ Title = "Config", Content = "Failed to update Auto Load", Duration = 3, Icon = "alert-circle" })
                end
            end,
        })

        SectionCfg:Button({
            Title    = "Create Config",
            Color    = Color3.fromRGB(57, 255, 20),
            Icon     = "plus-circle",
            Callback = function()
                local name = trimConfigName(configNameInput)
                if not name then
                    WindUI:Notify({ Title = "Config", Content = "Enter a valid config name", Duration = 3, Icon = "alert-circle" })
                    return
                end
                if configExists(name) then
                    WindUI:Notify({ Title = "Config", Content = "Config already exists", Duration = 3, Icon = "alert-triangle" })
                    return
                end
                local config = openConfig(name)
                if not config then
                    WindUI:Notify({ Title = "Config", Content = "Failed to create config", Duration = 3, Icon = "alert-circle" })
                    return
                end
                local ok = pcall(function() config:Save() end)
                if ok then
                    selectedConfig = name
                    refreshConfigDropdown(name)
                    syncAutoLoadToggle()
                    WindUI:Notify({ Title = "Config", Content = "Config created successfully", Duration = 3, Icon = "check-circle" })
                else
                    WindUI:Notify({ Title = "Config", Content = "Failed to create config", Duration = 3, Icon = "alert-circle" })
                end
            end,
        })

        SectionCfg:Button({
            Title    = "Save Config",
            Color    = Color3.fromRGB(57, 255, 20),
            Icon     = "save",
            Callback = function()
                if not selectedConfig or selectedConfig == "" then
                    WindUI:Notify({ Title = "Config", Content = "Please select a config first", Duration = 3, Icon = "alert-circle" })
                    return
                end
                local config = openConfig(selectedConfig)
                local ok = config and pcall(function() config:Save() end)
                WindUI:Notify({
                    Title = "Config",
                    Content = ok and "Config saved successfully" or "Failed to save config",
                    Duration = 3,
                    Icon = ok and "check-circle" or "alert-circle",
                })
            end,
        })

        SectionCfg:Button({
            Title    = "Load Config",
            Color    = Color3.fromRGB(24, 119, 242),
            Icon     = "folder-open",
            Callback = function()
                if not selectedConfig or selectedConfig == "" then
                    WindUI:Notify({ Title = "Config", Content = "Please select a config first", Duration = 3, Icon = "alert-circle" })
                    return
                end
                local config = openConfig(selectedConfig)
                local ok, result = false, nil
                if config then
                    ok, result = pcall(function() return config:Load() end)
                end
                local loaded = ok and result ~= false
                WindUI:Notify({
                    Title = "Config",
                    Content = loaded and "Config loaded successfully" or "Failed to load config",
                    Duration = 3,
                    Icon = loaded and "check-circle" or "alert-circle",
                })
            end,
        })

        SectionCfg:Button({
            Title    = "Delete Config",
            Icon     = "trash-2",
            Color    = Color3.fromRGB(220, 60, 60),
            Callback = function()
                if not selectedConfig or selectedConfig == "" then
                    WindUI:Notify({ Title = "Config", Content = "Please select a config first", Duration = 3, Icon = "alert-circle" })
                    return
                end
                local ok, result = pcall(function()
                    if ConfigManager.DeleteConfig then
                        return ConfigManager:DeleteConfig(selectedConfig)
                    end
                    local config = openConfig(selectedConfig)
                    return config and config:Delete()
                end)
                local deleted = ok and result ~= false
                if deleted then
                    refreshConfigDropdown()
                end
                WindUI:Notify({
                    Title = "Config",
                    Content = deleted and "Config deleted successfully" or "Failed to delete config",
                    Duration = 3,
                    Icon = deleted and "check-circle" or "alert-circle",
                })
            end,
        })
    end

    -- Section: Ui Setting
    local SectionConfig = TabSettings:Section({
        Title = "Ui setting",
        Icon  = "monitor",
        Side  = "left",
    })

    SectionConfig:Dropdown({
        Title       = "Theme",
        Flag        = "theme",
        Description = "เลือก Theme ของ UI",
        Values      = {"Dark", "Light", "Midnight", "Amber", "Aqua", "Rose", "Plant", "Red", "Indigo", "Sky", "Violet", "Emerald", "Crimson", "MonoKai Pro", "Cotton Candy", "Mellowsi", "Rianbow"},
        Value       = "Amber",
        Default     = "Light",
        Callback    = function(Value) WindUI:SetTheme(Value) end,
    })

    SectionConfig:Toggle({
        Title       = "Acrylic Background",
        Description = "เปิดใช้ Acrylic Blur",
        Icon = "layers",
        Flag        = "acrylic",
        Value       = false,
        Callback    = function(State) WindUI:ToggleAcrylic(State) end,
    })

    SectionConfig:Keybind({
        Title           = "Toggle UI",
        Flag            = "toggle_ui_keybind",
        Value           = "RightControl",
        Description     = "ปุ่มกด เปิด/ปิด UI",
        Default         = Enum.KeyCode.RightControl,
        Callback        = function()
            if self.Instance then
                self.Instance.Enabled = not self.Instance.Enabled
            else
                pcall(function() self:Toggle() end)
            end
        end,
        ChangedCallback = function(key) end,
    })

    loadAutoLoadConfig()

    WindUI:Notify({
        Title   = "Delex Hub",
        Content = "Successfully loaded Script! Enjoy your time in Roblox.!",
        Duration = 5,
        Icon    = "rbxassetid://97074562899662",
    })

    -- =============================================
    -- Mobile Toggle Button
    -- =============================================
    local CoreGui = game:GetService("CoreGui")
    
    -- ลบอันเก่าถ้ามี (ป้องกันปุ่มทับซ้อนเวลารันใหม่)
    for _, child in ipairs(CoreGui:GetChildren()) do
        if child.Name == "ChickChickToggle" then
            child:Destroy()
        end
    end
    if gethui then
        for _, child in ipairs(gethui():GetChildren()) do
            if child.Name == "ChickChickToggle" then
                child:Destroy()
            end
        end
    end

    local toggleGui = Instance.new("ScreenGui")
    toggleGui.Name = "DelexToggle"
    toggleGui.ResetOnSpawn = false

    if gethui then
        toggleGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(toggleGui)
        toggleGui.Parent = CoreGui
    else
        local ok = pcall(function() toggleGui.Parent = CoreGui end)
        if not ok then
            toggleGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
        end
    end

    local toggleBtn = Instance.new("ImageButton")
    toggleBtn.Name = "ToggleButton"
    toggleBtn.Parent = toggleGui
    toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    toggleBtn.BackgroundTransparency = 0.3
    toggleBtn.Position = UDim2.new(0, 20, 0, 20)
    toggleBtn.Size = UDim2.new(0, 50, 0, 50)
    toggleBtn.Image = "rbxassetid://97074562899662"

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = toggleBtn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.5
    stroke.Thickness = 1.5
    stroke.Parent = toggleBtn

    -- Dragging Logic
    local dragging
    local dragInput
    local dragStart
    local startPos

    local function update(input)
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = toggleBtn.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    toggleBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)

    -- Click Logic
    local clickStart = 0
    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            clickStart = tick()
        end
    end)

    toggleBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if tick() - clickStart < 0.3 then -- If released quickly, count as click
                if self.Instance then
                    self.Instance.Enabled = not self.Instance.Enabled
                else
                    pcall(function() self:Toggle() end)
                end
            end
        end
    end)

end

-- =============================================
-- Return โมดูล
-- =============================================

return Window
